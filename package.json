{
  "name": "perly-golf-max",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:docs": "markdownlint README.md .github/copilot-instructions.md",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "lockfile:public": "node scripts/public-lockfile.mjs && npm run check:lockfile",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run && node --test scripts/lockfile.test.mjs",
    "test:watch": "vitest",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "markdownlint-cli": {
      "run-con": "1.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.56.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "markdownlint-cli": "0.45.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
